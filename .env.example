# Telegram Bot API (публикация)
TG_BOT_TOKEN=

# Telegram MTProto (Telethon) — чтение чужих каналов-источников
# Получить на https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=news_rewriter_session

# VK — токен с правами wall (чтение стен сообществ-источников)
VK_USER_TOKEN=

# VK Group API (публикация в свою группу)
VK_GROUP_TOKEN=

# Опционально: личный токен АДМИНА группы, ТОЛЬКО для загрузки фото/видео —
# group-токен не может (VK error 27 "method is unavailable with group auth").
# wall.post всегда через VK_GROUP_TOKEN. Не задан — публикация работает best-effort
# текстом без вложения.
VK_PHOTO_UPLOAD_TOKEN=

# Groq API (бесплатный облачный LLM для рерайта, по умолчанию вместо Ollama/Gemini)
# Получить ключ на https://console.groq.com/keys (регистрация без карты)
GROQ_API_KEY=

# Control-бот управления софтом (ОТДЕЛЬНЫЙ бот, не тот что публикует посты в канал).
# Команды /run /stop /status /publish /queue /provider. Создать бота у @BotFather.
# Владелец — первый, кто нажал /start (или задать CONTROL_BOT_OWNER_ID — числовой user id).
CONTROL_BOT_TOKEN=
CONTROL_BOT_OWNER_ID=

# Путь к репозиторию vk-nature-bot (отдельный проект, свой venv — код НЕ сливаем,
# см. CLAUDE.md). Задан — control-бот включает команды /nature_run /nature_stop
# /nature_status для управления им как отдельным процессом с одного пульта.
NATURE_BOT_PATH=C:\Users\Professional\Desktop\vk-nature-bot

# Путь к репозиторию MoneyPrinter Turbo / Shorts (отдельный проект, свой venv,
# уже настроен реальными ключами Pexels+Groq в его собственном config.toml).
# Задан — control-бот включает /shorts_run /shorts_stop /shorts_status и
# /shorts <id поста> (генерирует короткое видео из рерайта поста и присылает
# сюда файлом на проверку — не публикует само).
SHORTS_PATH=C:\Users\Professional\Desktop\Shorts
# Адрес, на котором Shorts поднимает свой FastAPI (см. его config.toml [app] host/port).
SHORTS_BASE_URL=http://127.0.0.1:8080

# OpenRouter — агрегатор бесплатных моделей (llm.provider: "openrouter" в config.yaml).
# Free tier: 20 запросов/мин, 50/день (или 1000/день после пополнения от $10 — :free-модели
# при этом остаются бесплатными). Модель указывать с суффиксом ":free", напр.
# meta-llama/llama-3.3-70b-instruct:free, либо "openrouter/auto" для автоподбора.
# Получить ключ на https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gemini API — альтернативный provider (llm.provider: "gemini" в config.yaml).
# Бесплатный tier может давать всего 20 запросов/день на модель — см. известные грабли в CLAUDE.md.
# Получить ключ на https://ai.google.dev/ (Google AI Studio → Get API key)
GEMINI_API_KEY=

# Прокси для облачных LLM, если провайдер недоступен напрямую из РФ (Gemini —
# гео-блок датацентр/VPN-диапазонов). SOCKS5/HTTP. Формат: socks5h://user:pass@host:port
LLM_PROXY_URL=

# Сток-API изображений (опционально, только используемые провайдеры)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
